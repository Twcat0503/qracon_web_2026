---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Timetable from '../../components/agenda/Timetable.astro';
import SessionDialog from '../../components/agenda/SessionDialog.astro';
import FlapText from '../../components/FlapText.astro';
import { sessions, typeLabels, isListed, phases } from '../../data/sessions';
import { site } from '../../data/site';
import type { SessionType } from '../../types/agenda';

const order: SessionType[] = [
  'keynote',
  'talk',
  'lightning',
  'workshop',
  'submission',
  'debate',
  'roundtable',
  'exhibit',
  'screening',
  'activity',
];
const present = new Set(sessions.filter(isListed).map((s) => s.type));
const filterTypes = order.filter((t) => present.has(t));
---

<BaseLayout
  title="議程"
  description={`QRACON 2026 議程草案：${site.dateLabel}（${site.weekday}）在${site.venue.org}${site.venue.name}，10 處場地同時進行的一天。`}
>
  <link slot="head" rel="expect" href="#timetable" blocking="render" />
  <PageHead
    title="議程"
    status="草案"
    lede={`${site.dateLabel}（${site.weekday}）・${site.venue.org} ${site.venue.name}`}
  />

  <div class="wrap agenda">
    <section class="now-board" data-now-board hidden aria-labelledby="now-title">
      <h2 class="now-board__title" id="now-title">
        現在{' '}
        <time class="now-board__clock" data-now-clock>
          <FlapText text="00:00" size="lg" mode="live" />
        </time>
        <span class="now-board__preview" data-now-preview hidden>
          預覽模式
        </span>
      </h2>
      <div class="now-board__cols">
        <div>
          <h3>進行中</h3>
          <ul role="list" data-now-list></ul>
        </div>
        <div>
          <h3>
            下一場 <time class="now-board__next" data-next-time></time>
          </h3>
          <ul role="list" data-next-list></ul>
        </div>
      </div>
    </section>

    <div class="agenda-controls" data-agenda-controls>
      <div class="mobile-controls">
        <label class="mobile-controls__jump">
          <span>跳至時段</span>
          <select data-phase-jump aria-label="跳至議程時段">
            <option value="">選擇時段</option>
            {phases.map((phase) => (
              <option value={phase.id}>
                {phase.from} {phase.label}
              </option>
            ))}
          </select>
        </label>
        <button
          class="mobile-controls__filter"
          type="button"
          data-filter-toggle
          aria-expanded="false"
          aria-controls="agenda-filters"
        >
          篩選 <span data-filter-summary>全部</span>
        </button>
      </div>
      <nav class="phase-route" aria-label="時段">
        <ol role="list">
          {phases.map((p) => (
            <li>
              <a href={`#${p.id}`}>
                <span class="phase-route__stop">
                  <span class="phase-route__dot" aria-hidden="true" />
                  <span class="phase-route__name">{p.label}</span>
                </span>
                <span class="phase-route__time">{p.from}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="tt-tools" id="agenda-filters" data-tt-tools hidden>
        <fieldset class="tt-tools__types">
          <legend>依類型篩選</legend>
          <div class="tt-tools__chips">
            {filterTypes.map((t) => (
              <button type="button" class="chip" data-filter-type={t} aria-pressed="false">
                {typeLabels[t]}
              </button>
            ))}
          </div>
        </fieldset>
        <div class="tt-tools__side">
          <button type="button" class="chip chip--punched" data-filter-punched aria-pressed="false">
            只看已收藏
            <span class="chip__count">
              （<span data-punched-count>0</span>）
            </span>
          </button>
          <button type="button" class="tt-tools__clear" data-filter-clear hidden>
            清除篩選
          </button>
          <p class="tt-tools__count" aria-live="polite" data-tt-count></p>
        </div>
      </div>
    </div>
    <div class="tt-empty" data-tt-empty hidden role="status">
      <p>沒有符合條件的場次，試試其他類型或清除篩選。</p>
      <button type="button" class="chip" data-filter-reset>
        清除篩選
      </button>
    </div>
    <Timetable />
    <SessionDialog />
  </div>
</BaseLayout>

<style>
  .agenda {
    display: grid;
    gap: var(--space-6);
  }

  .now-board {
    padding: var(--space-5) var(--space-6);
    background: var(--color-ink);
    color: var(--color-white);
    border-radius: var(--radius-chip);
    --color-focus: var(--color-white);
    --flap-bg: var(--color-ink-raised);
  }

  .now-board__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-xl);
  }

  .now-board__clock,
  .now-board__next {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    letter-spacing: 0.04em;
  }

  .now-board__clock {
    font-size: var(--text-3xl);
  }

  .now-board__preview {
    padding: 0 0.5em;
    border: var(--rule-mid) solid currentColor;
    border-radius: var(--radius-chip);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }

  .now-board__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5) var(--space-7);
    margin-top: var(--space-4);
  }

  .now-board h3 {
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-thin) solid var(--color-white);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
  }

  .now-board ul {
    margin: 0;
  }

  .now-board :global(li) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
    padding-block: var(--space-2);
    border-bottom: var(--rule-hair) solid var(--color-on-ink-rule);
    color: var(--color-on-ink-soft);
    font-size: var(--text-sm);
  }

  .now-board :global(li a) {
    color: var(--color-white);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }

  .agenda-controls {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .mobile-controls {
    display: none;
  }
  .phase-route ol {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
    margin: 0;
  }
  .phase-route li {
    position: relative;
    flex: 1 1 10rem;
  }
  .phase-route li::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1.75rem - 1px);
    height: 2px;
    background: var(--color-ink);
  }
  .phase-route li:last-child::before {
    display: none;
  }
  .phase-route a {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    grid-template-rows: 2rem auto;
    column-gap: var(--space-2);
    align-items: center;
    padding-block: 0.75rem;
    text-decoration: none;
  }
  .phase-route__stop {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding-right: 0.75rem;
    background: var(--color-paper);
  }
  .phase-route__dot {
    flex: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-white);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .phase-route a:hover .phase-route__dot {
    background: var(--color-ink);
  }
  .phase-route__name {
    font-weight: var(--weight-bold);
  }
  .phase-route a:hover .phase-route__name {
    text-decoration: underline;
  }
  .phase-route__time {
    grid-column: 2;
    grid-row: 2;
    padding-inline: var(--space-2);
    color: var(--color-ink-soft);
    font-family: var(--font-sign);
    font-weight: var(--weight-sign);
    font-size: var(--text-sm);
  }
  .tt-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-5) var(--space-6);
    padding: var(--space-5);
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-chip);
    background: var(--color-white);
  }
  .tt-tools__types {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .tt-tools__types legend {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
  }
  .tt-tools__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    min-height: 2.75rem;
    padding: var(--space-1) 0.875rem;
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-chip);
    background: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .chip:hover {
    background: var(--color-paper-deep);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-white);
  }
  .chip__count {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
  }
  .chip__count [data-punched-count] {
    display: inline-block;
  }
  .tt-tools__side {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding-left: var(--space-5);
    border-left: var(--rule-hair) solid var(--color-rule-fine);
  }
  .tt-tools__clear {
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-2);
    border: 0;
    background: transparent;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .tt-tools__count {
    grid-column: 1 / -1;
    margin-top: var(--space-1);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
  .tt-empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--rule-mid) dashed var(--color-ink);
  }
  @media (max-width: 71.99rem) {
    :global(html.js) .agenda-controls {
      position: sticky;
      top: 0;
      z-index: 10;
      gap: var(--space-3);
      margin-inline: calc(-1 * var(--gutter));
      padding: var(--space-3) var(--gutter);
      border-bottom: var(--rule-mid) solid var(--color-ink);
      background: var(--color-paper);
    }
    :global(html.js) .mobile-controls {
      display: flex;
      align-items: end;
      gap: var(--space-3);
    }
    :global(html.js) .phase-route {
      display: none;
    }
    :global(html.js) .agenda-controls:not([data-filters-open]) .tt-tools {
      display: none;
    }
    .mobile-controls__jump {
      display: grid;
      gap: var(--space-1);
      flex: 1;
      min-width: 0;
      font-size: var(--text-xs);
      font-weight: var(--weight-bold);
    }
    .mobile-controls__jump select {
      width: 100%;
      min-height: 2.75rem;
      padding: var(--space-2);
      border: var(--rule-thin) solid var(--color-ink);
      border-radius: var(--radius-chip);
      background: var(--color-white);
      font-size: var(--text-sm);
    }
    .mobile-controls__filter {
      min-height: 2.75rem;
      padding: var(--space-2) var(--space-3);
      border: var(--rule-thin) solid var(--color-ink);
      border-radius: var(--radius-chip);
      background: var(--color-white);
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      white-space: nowrap;
    }
    .mobile-controls__filter span {
      margin-left: var(--space-1);
      font-size: var(--text-xs);
      font-weight: var(--weight-regular);
    }
    .mobile-controls__filter[aria-expanded='true'] {
      background: var(--color-ink);
      color: var(--color-white);
    }
    .tt-tools {
      grid-template-columns: 1fr;
      max-height: min(60svh, 26rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-4);
      gap: var(--space-4);
    }
    .tt-tools__side {
      padding: var(--space-3) 0 0;
      border-left: 0;
      border-top: var(--rule-hair) solid var(--color-rule-fine);
      grid-template-columns: auto 1fr;
    }
    .tt-tools__clear {
      justify-self: end;
    }
    .tt-tools__count {
      text-align: left;
    }
    .phase-route ol {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
</style>

<script>
  import { initAgenda } from '../../scripts/agenda';
  initAgenda();
</script>
