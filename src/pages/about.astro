---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import RowTable from '../components/RowTable.astro';
import Stamp from '../components/Stamp.astro';
import { site } from '../data/site';

const editions = [
  {
    year: '2026',
    label: '第四屆',
    place: `${site.venue.city}・${site.venue.org}${site.venue.name}`,
    theme: site.theme.title,
    current: true,
  },
  { year: '2025', label: '第三屆', place: '臺北・人文社會科學館', theme: 'Planck 100 普朗克百年', current: false },
];
---

<BaseLayout title="關於" description={site.description}>
  <PageHead
    title="關於 QRACON"
    lede={`QRACON（${site.nameEn}）是由學生主導的量子科技年會，今年邁入第四屆。`}
  />

  <div class="wrap about-page">
    <section class="about-page__intro" aria-labelledby="why-title">
      <h2 id="why-title">為什麼要辦這場年會</h2>
      <p>
        量子科技橫跨學術研究、產業應用與教育推廣，這三群人卻很少在同一個場合碰面。QRACON
        想讓學術界、產業界與教育端在同一天交流，也想接起中學到大學之間的那道斷層：讓對量子好奇的高中生，看得到大學與研究的樣子；也讓研究者與業界，遇見下一代的量子人。
      </p>
      <p>
        2026 年，年會第一次離開臺北，移師臺南的{site.venue.org}{site.venue.name}。
      </p>
    </section>

    <section class="about-page__editions" aria-labelledby="editions-title">
      <h2 id="editions-title">歷屆</h2>
      <ol class="editions" role="list">
        {
          editions.map((e) => (
            <li class:list={['editions__row', { 'is-current': e.current }]}>
              <p class="editions__year">{e.year}</p>
              <p class="editions__label">{e.label}</p>
              <p class="editions__place">{e.place}</p>
              <p class="editions__theme">
                年度主題　{e.theme ?? <Stamp label="待公布" tilt={false} />}
              </p>
            </li>
          ))
        }
        <li class="editions__row editions__row--todo">
          <p class="editions__year">—</p>
          <p class="editions__label">第一、二屆</p>
          <p class="editions__place">
            <Stamp label="資料待補" tilt={false} />
          </p>
        </li>
      </ol>
    </section>

    <section class="about-page__org" aria-labelledby="org-title">
      <h2 class="visually-hidden" id="org-title">單位與聯絡</h2>
      <RowTable
        caption="單位與聯絡"
        rows={[
          { label: '指導單位', value: site.advisor },
          { label: '主辦單位', value: site.organizers?.join('、') ?? null, stamp: '待確認' },
          { label: '聯絡信箱', value: site.contactEmail },
          { label: '社群帳號', value: site.social.length ? site.social.map((s) => s.label).join('、') : null },
        ]}
      />
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-9);
  }

  .about-page h2 {
    margin-bottom: var(--space-5);
    font-size: var(--text-2xl);
  }

  .about-page__intro {
    grid-column: 1 / span 7;
  }

  .about-page__intro p {
    max-width: var(--measure);
    font-size: var(--text-md);
  }

  .about-page__intro p + p {
    margin-top: var(--space-4);
  }

  .about-page__editions,
  .about-page__org {
    grid-column: 1 / -1;
  }

  .editions {
    margin: 0;
    border-top: var(--rule-heavy) solid var(--color-ink);
  }

  .editions__row {
    display: grid;
    grid-template-columns: 7rem 7rem minmax(0, 1fr) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }

  .editions__row.is-current {
    padding-inline: var(--space-4);
    background: var(--color-white);
    border-left: var(--rule-block) solid var(--color-ink);
  }

  .editions__year {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .editions__label {
    font-weight: var(--weight-black);
  }

  .editions__theme {
    color: inherit;
  }

  .editions__row--todo {
    color: var(--color-ink-soft);
  }

  @media (max-width: 71.99rem) {
    .about-page__intro {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .editions__row {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .editions__place,
    .editions__theme {
      grid-column: 1 / -1;
    }
  }

  .editions__row { align-items: center; min-height: 6.5rem; padding-inline: 1rem; }
  .editions__row.is-current .editions__year { width: fit-content; padding: 0.2em 0.3em; background: var(--color-ink); color: var(--color-white); border-radius: var(--radius-chip); }
  .editions__theme { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .about-page__org { max-width: 58rem; width: 100%; }
  .about-page__org :global(.row-table tbody tr:first-child td) { font-family: var(--font-sign); font-size: clamp(1.6rem, 3vw, 2.25rem); font-weight: var(--weight-sign-heavy); letter-spacing: -0.02em; }
  .about-page__org :global(.row-table tbody tr:first-child) { background: var(--color-white); }


  .about-page__intro { grid-column: 1 / span 6; grid-row: 1; }
  .about-page__org { grid-column: 8 / -1; grid-row: 1; max-width: none; align-self: start; }
  .about-page__editions { grid-row: 2; }
  .about-page__org :global(.row-table tbody th) { width: 34%; font-size: 0.95rem; }
  .about-page__org :global(.row-table tbody tr:first-child td) { font-size: clamp(1.5rem, 2vw, 2rem); }
  @media (max-width: 71.99rem) {
    .about-page__intro, .about-page__org, .about-page__editions { grid-column: 1 / -1; grid-row: auto; }
    .about-page__org { order: 1; }
    .about-page__editions { order: 2; }
  }


  .editions__row.is-current { border-left: 0; box-shadow: inset 4px 0 0 var(--color-ink); }
  .editions__row.is-current .editions__year { width: auto; padding: 0; background: none; color: var(--color-ink); border-radius: 0; }
  .editions__year { font-size: 2.5rem; }
  .editions__row.is-current .editions__label { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.4em; }

</style>
