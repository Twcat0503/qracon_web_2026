---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import EmptyState from '../components/EmptyState.astro';
---

<BaseLayout title="籌備團隊" description="QRACON 2026 籌備團隊名單。">
  <PageHead title="籌備團隊" status="待公布" />

  <div class="wrap team-page">
    <EmptyState class="team-page__empty" label="名單待公布" />
  </div>
</BaseLayout>

<style>
  .team-page :global(.team-page__empty) {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }
</style>
