---

const W = 1000;
const H = 100;
const points: string[] = [];
for (let i = 0; i <= 200; i++) {
  const x = (i / 200) * W;
  const u = (x - W * 0.62) / W;
  const envelope = Math.exp(-(u * u) * 9);
  const fringe = Math.cos(u * 42) ** 2;
  const y = H * 0.8 - H * 0.62 * envelope * fringe;
  points.push(`${x.toFixed(1)},${y.toFixed(1)}`);
}
const staticCurve = `M${points.join(' L')}`;
---

<div class="field" data-field>
  <div class="field__fallback" aria-hidden="true"></div>
  <canvas class="field__canvas" data-field-canvas aria-hidden="true"></canvas>
</div>

<div class="readout" data-readout>
  <svg
    class="readout__static"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d={staticCurve}></path>
  </svg>
</div>

<style>
  .field {
    position: absolute;
    inset: 0;
    z-index: var(--z-field);
    overflow: hidden;
    pointer-events: none;
  }

  .field__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  
  .field__fallback {
    --ring: color-mix(in oklab, var(--color-ink) 20%, transparent);
    --pitch: 0.875rem; 
    position: absolute;
    inset: 0;
    background:
      repeating-radial-gradient(
        circle at var(--sa-x, 90%) var(--sa-y, 86%),
        var(--ring) 0 0.1rem,
        transparent 0.1rem var(--pitch)
      ),
      repeating-radial-gradient(
        circle at var(--sb-x, 93%) var(--sb-y, 86%),
        var(--ring) 0 0.1rem,
        transparent 0.1rem var(--pitch)
      );
    mask-image: radial-gradient(
      ellipse 90% 100% at var(--sa-x, 90%) var(--sa-y, 86%),
      var(--color-ink) 20%,
      transparent 95%
    );
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .field:global(.is-live) .field__canvas {
    opacity: 1;
  }

  .field:global(.is-live) .field__fallback {
    opacity: 0;
  }

  .readout {
    position: relative;
    z-index: var(--z-content);
    height: 4.5rem;
    border-top: var(--rule-heavy) solid var(--color-ink);
  }

  .readout__static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  
  :global(.is-live) ~ .readout .readout__static {
    opacity: 0;
  }

  @media (max-width: 40rem) {
    .readout {
      height: 5rem;
    }
  }
</style>

<script>
  type NavigatorWithConnection = Navigator & { connection?: { saveData?: boolean } };

  const root = document.querySelector<HTMLElement>('[data-field]');
  const hero = root?.closest<HTMLElement>('[data-hero]');

  if (root && hero) {
    const fallback = root.querySelector<HTMLElement>('.field__fallback');

    const alignFallback = () => {
      if (!fallback) return;
      const box = root.getBoundingClientRect();
      (['a', 'b'] as const).forEach((key) => {
        const slit = hero.querySelector(`[data-slit="${key}"]`);
        if (!slit || !box.width || !box.height) return;
        const r = slit.getBoundingClientRect();
        const x = ((r.left + r.width / 2 - box.left) / box.width) * 100;
        const y = ((r.top + r.height / 2 - box.top) / box.height) * 100;
        fallback.style.setProperty(`--s${key}-x`, `${x.toFixed(2)}%`);
        fallback.style.setProperty(`--s${key}-y`, `${y.toFixed(2)}%`);
      });
    };
    new ResizeObserver(alignFallback).observe(root);
    document.fonts?.ready.then(alignFallback).catch(() => {});

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cores = navigator.hardwareConcurrency ?? 8;
    const saveData = (navigator as NavigatorWithConnection).connection?.saveData === true;

    if (!reduce && cores > 4 && !saveData) {
      const start = () => {
        import('../../scripts/interference')
          .then(({ mount }) => mount(root))
          .catch((error: unknown) => console.error('[interference] failed to load', error));
      };
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(start, { timeout: 1500 });
      } else {
        setTimeout(start, 400);
      }
    }
  }
</script>

