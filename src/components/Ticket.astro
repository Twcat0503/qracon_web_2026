---

interface Props {
  
  slits?: boolean;
  
  stamp?: string;
  class?: string;
  labelledby?: string;
}

const { slits = false, stamp, class: className, labelledby } = Astro.props;
---

<div class:list={['ticket-drop', className]}>
  <div
    class:list={['ticket', { 'ticket--slits': slits }]}
    role="group"
    aria-labelledby={labelledby}
  >
    <div class="ticket__frame">
      <slot />
    </div>
    {
      slits && (
        <>
          <span class="ticket__slit ticket__slit--a" data-slit="a" aria-hidden="true" />
          <span class="ticket__slit ticket__slit--b" data-slit="b" aria-hidden="true" />
        </>
      )
    }
    {
      stamp && (
        <span class="ticket__datestamp" aria-hidden="true">
          {stamp}
        </span>
      )
    }
  </div>
</div>

<style>
  
  .ticket-drop {
    filter: var(--drop-ticket);
  }

  
  .ticket {
    --slit-w: 0.375rem;
    --slit-h: 3rem;
    --slit-gap: 2.25rem;
    --slit-inset: 1.5rem;
    --slit-bottom: 1.25rem;
    --slit-zone: calc(var(--slit-inset) + var(--slit-w) * 2 + var(--slit-gap) + var(--space-3));
    position: relative;
    background: var(--color-white);
    border-radius: var(--radius-ticket);
    color: var(--color-ink);
  }

  .ticket--slits {
    -webkit-mask:
      linear-gradient(var(--color-ink) 0 0) no-repeat 0 0 / 100% 100%,
      linear-gradient(var(--color-ink) 0 0) no-repeat
        right calc(var(--slit-inset) + var(--slit-w) + var(--slit-gap)) bottom var(--slit-bottom) /
        var(--slit-w) var(--slit-h),
      linear-gradient(var(--color-ink) 0 0) no-repeat right var(--slit-inset) bottom
        var(--slit-bottom) / var(--slit-w) var(--slit-h);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(var(--color-ink) 0 0) no-repeat 0 0 / 100% 100%,
      linear-gradient(var(--color-ink) 0 0) no-repeat
        right calc(var(--slit-inset) + var(--slit-w) + var(--slit-gap)) bottom var(--slit-bottom) /
        var(--slit-w) var(--slit-h),
      linear-gradient(var(--color-ink) 0 0) no-repeat right var(--slit-inset) bottom
        var(--slit-bottom) / var(--slit-w) var(--slit-h);
    mask-composite: exclude;
  }

  .ticket__frame {
    position: relative;
    margin: var(--space-2);
    padding: var(--space-5);
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-ticket-inner);
  }

  
  .ticket__slit {
    position: absolute;
    bottom: var(--slit-bottom);
    width: var(--slit-w);
    height: var(--slit-h);
  }

  .ticket__slit--a {
    right: calc(var(--slit-inset) + var(--slit-w) + var(--slit-gap));
  }

  .ticket__slit--b {
    right: var(--slit-inset);
  }

  .ticket__datestamp {
    position: absolute;
    right: var(--space-6);
    top: 36%;
    padding: 0.1em 0.45em;
    border: var(--rule-mid) solid var(--color-ink-muted);
    border-radius: var(--radius-chip);
    color: var(--color-ink-muted);
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    rotate: -6deg;
    pointer-events: none;
  }

  
  @media (prefers-reduced-motion: no-preference) {
    :global([data-validated]) .ticket__datestamp {
      animation: stamp-press var(--dur-base) var(--ease-out);
    }

    @keyframes stamp-press {
      from {
        opacity: 0.3;
        scale: 1.35;
        rotate: -12deg;
      }
    }
  }

  @media (max-width: 34rem) {
    .ticket__frame {
      padding: var(--space-4);
    }

    
    .ticket__datestamp {
      display: none;
    }
  }
</style>

