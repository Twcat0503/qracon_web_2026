---
import { sessions, isListed } from '../../data/sessions';
import SessionContent from './SessionContent.astro';
---

<dialog class="session-dialog" data-session-dialog aria-label="議程詳情">
  <div class="session-dialog__bar">
    <span>QRACON 2026 · 議程詳情</span>
    <button
      class="session-dialog__close"
      type="button"
      data-dialog-close
      autofocus
      aria-label="關閉議程詳情"
    >
      關閉 <span aria-hidden="true">×</span>
    </button>
  </div>
  {sessions.filter(isListed).map((session) => (
    <section class="session-detail" data-session-detail={session.id} hidden>
      <SessionContent session={session} titleId={`dialog-title-${session.id}`} />
    </section>
  ))}
</dialog>

<style>
  .session-dialog {
    position: fixed;
    inset: 0;
    width: min(42rem, calc(100% - 2rem));
    max-width: calc(100% - 2rem);
    max-height: calc(100svh - 2rem);
    margin: auto;
    padding: 0;
    border: 2px solid var(--color-ink);
    border-radius: 8px;
    background: var(--color-white);
    color: var(--color-ink);
    overflow: auto;
    overscroll-behavior: contain;
    box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 0.25);
  }
  .session-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
  }
  .session-dialog__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1.5rem;
    border-bottom: 1px solid var(--color-ink);
    background: var(--color-white);
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
  }
  .session-dialog__close {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.25rem 0.5rem;
    border: 0;
    border-radius: 3px;
    background: transparent;
    font-weight: var(--weight-bold);
  }
  .session-dialog__close span {
    font-size: 1.5rem;
    line-height: 1;
  }
  .session-dialog__close:hover {
    background: var(--color-paper);
  }
  @media (max-width: 47.99rem) {
    .session-dialog__bar {
      padding-inline: 1rem;
      gap: 0.5rem;
    }
  }
  @media (max-height: 30rem) {
    .session-dialog {
      max-height: calc(100svh - 1rem);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-session-dialog]');
  if (dialog) {
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-session-detail]')];
    let opener: HTMLAnchorElement | null = null;
    let previousOverflow = '';
    let backdropPress = false;
    const outside = (event: MouseEvent) => {
      const box = dialog.getBoundingClientRect();
      return (
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom
      );
    };
    document.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      const link =
        event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
      const url = new URL(link.href, location.href);
      const match = url.origin === location.origin && url.pathname.match(/^\/agenda\/([^/]+)\/?$/);
      if (!match) return;
      const panel = panels.find((item) => item.dataset.sessionDetail === match[1]);
      if (!panel) return;
      event.preventDefault();
      opener = link;
      panels.forEach((item) => {
        item.hidden = item !== panel;
      });
      dialog.setAttribute('aria-labelledby', `dialog-title-${match[1]}`);
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      dialog.scrollTop = 0;
    });
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('pointerdown', (event) => {
      backdropPress = event.target === dialog && outside(event);
    });
    dialog.addEventListener('click', (event) => {
      if (backdropPress && event.target === dialog && outside(event)) dialog.close();
      backdropPress = false;
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
      opener?.focus({ preventScroll: true });
      document.dispatchEvent(new Event('agenda:reset-highlight'));
    });
    document.querySelectorAll<HTMLAnchorElement>('.s__title a').forEach((link) => {
      link.setAttribute('aria-haspopup', 'dialog');
    });
  }
</script>
