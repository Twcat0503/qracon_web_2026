---
import { sessions, isListed, canBookmark, typeLabels } from '../../data/sessions';
import { roomById } from '../../data/rooms';
import { site } from '../../data/site';
import { hhmm, durationLabel } from '../../utils/time';
import PunchToggle from './PunchToggle.astro';
import Stamp from '../Stamp.astro';
---

<dialog class="session-dialog" data-session-dialog aria-label="議程詳情">
  <div class="session-dialog__bar">
    <span>QRACON 2026 · 議程草案</span>
    <button class="session-dialog__close" type="button" data-dialog-close autofocus aria-label="關閉議程詳情">關閉 <span aria-hidden="true">×</span></button>
  </div>
  {sessions.filter(isListed).map((session) => (
    <section class="session-detail" data-session-detail={session.id} hidden>
      <p class="session-detail__type">{typeLabels[session.type]}</p>
      <h2 id={`dialog-title-${session.id}`}>{session.title}</h2>
      <dl class="session-detail__facts">
        <div><dt>日期</dt><dd>{site.dateLabel}（{site.weekday}）</dd></div>
        <div><dt>時間</dt><dd><time datetime={session.start}>{hhmm(session.start)}</time> – <time datetime={session.end}>{hhmm(session.end)}</time><small>{durationLabel(session.start, session.end)}</small></dd></div>
        <div><dt>場地</dt><dd>{session.rooms === 'all' ? '全體' : session.rooms.map((id) => roomById(id).name).join('、')}</dd></div>
      </dl>
      <div class="session-detail__body">
        <section><h3>講者</h3><Stamp label="待公布" tilt={false} /></section>
        <section><h3>摘要</h3>{session.abstract ? <p>{session.abstract}</p> : <Stamp label="待公布" tilt={false} />}</section>
        {session.note && <section><h3>草案備註</h3><p>{session.note}</p></section>}
      </div>
      {canBookmark(session) && <div class="session-detail__actions"><PunchToggle id={session.id} title={session.title} variant="full" /></div>}
    </section>
  ))}
</dialog>

<style>
  .session-dialog {
    position: fixed;
    inset: 0;
    width: min(42rem, calc(100% - 2rem));
    max-height: calc(100svh - 2rem);
    margin: auto;
    padding: 0;
    border: 2px solid var(--color-ink);
    border-radius: 8px;
    background: var(--color-white);
    color: var(--color-ink);
    overflow: auto;
    overscroll-behavior: contain;
    box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 0.25);
  }
  .session-dialog::backdrop { background: rgb(0 0 0 / 0.55); backdrop-filter: blur(4px); }
  .session-dialog__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1.5rem;
    border-bottom: 1px solid var(--color-ink);
    background: var(--color-white);
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
  }
  .session-dialog__close { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 2.75rem; padding: 0.25rem 0.5rem; border: 0; border-radius: 3px; background: transparent; font-weight: var(--weight-bold); }
  .session-dialog__close span { font-size: 1.5rem; line-height: 1; }
  .session-dialog__close:hover { background: var(--color-paper); }
  .session-detail { padding: 2rem; }
  .session-detail__type { margin-bottom: 0.75rem; font-size: 0.875rem; font-weight: var(--weight-bold); color: var(--color-ink-soft); }
  .session-detail h2 { font-size: clamp(1.5rem, 4vw, 2.25rem); line-height: 1.4; }
  .session-detail__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; padding-block: 1.5rem; margin-top: 1.5rem; border-block: 1px solid var(--color-ink); }
  .session-detail__facts > div:last-child { grid-column: 1 / -1; }
  .session-detail dt { margin-bottom: 0.25rem; font-size: 0.75rem; color: var(--color-ink-soft); }
  .session-detail dd { margin: 0; font-weight: var(--weight-bold); }
  .session-detail small { display: block; font-size: 0.75rem; font-weight: var(--weight-regular); color: var(--color-ink-soft); }
  .session-detail__body { display: grid; gap: 1.5rem; padding-block: 1.5rem; }
  .session-detail h3 { margin-bottom: 0.75rem; font-size: 1rem; }
  .session-detail__actions { padding-top: 1.25rem; border-top: 1px solid var(--color-rule-fine); }
  @media (max-width: 47.99rem) {
    .session-detail { padding: 1.25rem; }
    .session-dialog__bar { padding-inline: 1rem; }
    .session-detail__facts { grid-template-columns: 1fr; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-session-dialog]');
  if (dialog) {
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-session-detail]')];
    let opener: HTMLAnchorElement | null = null;
    let previousOverflow = '';
    let backdropPress = false;
    const outside = (event: MouseEvent) => {
      const box = dialog.getBoundingClientRect();
      return event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom;
    };
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
      const url = new URL(link.href, location.href);
      const match = url.origin === location.origin && url.pathname.match(/^\/agenda\/([^/]+)\/?$/);
      if (!match) return;
      const panel = panels.find((item) => item.dataset.sessionDetail === match[1]);
      if (!panel) return;
      event.preventDefault();
      opener = link;
      panels.forEach((item) => { item.hidden = item !== panel; });
      dialog.setAttribute('aria-labelledby', `dialog-title-${match[1]}`);
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      dialog.scrollTop = 0;
    });
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('pointerdown', (event) => { backdropPress = event.target === dialog && outside(event); });
    dialog.addEventListener('click', (event) => {
      if (backdropPress && event.target === dialog && outside(event)) dialog.close();
      backdropPress = false;
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
      opener?.focus({ preventScroll: true });
      document.dispatchEvent(new Event('agenda:reset-highlight'));
    });
    document.querySelectorAll<HTMLAnchorElement>('.s__title a').forEach((link) => {
      link.setAttribute('aria-haspopup', 'dialog');
    });
  }
</script>
