---
import { typeLabels, isListed, canBookmark, phases } from '../../data/sessions';
import { rooms } from '../../data/rooms';
import { hhmm, minutesOf, toMinutes } from '../../utils/time';
import {
  gridRow,
  sessionColumns,
  sessionRoomLabel,
  orderedSessions,
  rowTemplate,
  timeMarkers,
  formatMinutes,
  eventDateTime,
} from '../../utils/timetable';
import PunchToggle from './PunchToggle.astro';
import Words from '../Words.astro';
---

<div
  class="timetable-board"
  id="timetable"
  data-timetable-board
  style={`--room-count: ${rooms.length}; --row-template: ${rowTemplate}`}
>
  <p class="visually-hidden" id="timetable-help">
    左側為時間，右側場地可左右滑動。點選議程開啟詳情，虛線圈圈可收藏場次。
  </p>
  <div class="tt-rail">
    <div class="tt-rail__head" aria-hidden="true">
      時間
    </div>
    {timeMarkers.map((minutes) => (
      <div
        class="tt__mark"
        data-row={gridRow(minutes)}
        style={`--r0: ${gridRow(minutes)}`}
        aria-hidden="true"
      >
        <time datetime={eventDateTime(minutes)}>{formatMinutes(minutes)}</time>
      </div>
    ))}
    {phases.map((phase) => (
      <h2
        class="tt__phase"
        id={phase.id}
        data-phase-start={toMinutes(phase.from)}
        data-phase-end={toMinutes(phase.to)}
        style={`--r0: ${gridRow(toMinutes(phase.from))}; --r1: ${gridRow(toMinutes(phase.to))}`}
      >
        {phase.label}
      </h2>
    ))}
  </div>
  <div
    class="tt-scroll"
    data-room-track
    tabindex="0"
    role="region"
    aria-label="各場地議程表，可左右滑動"
    aria-describedby="timetable-help"
  >
    <div class="tt">
      {rooms.map((room, index) => (
        <div
          class="tt__room"
          data-col={index + 1}
          data-room-id={room.id}
          style={`--c0: ${index + 1}`}
        >
          {room.short}
        </div>
      ))}
      {timeMarkers.map((minutes) => (
        <div class="tt__rule" style={`--r0: ${gridRow(minutes)}`} aria-hidden="true" />
      ))}
      {orderedSessions.map((session) => {
        const [c0, c1] = sessionColumns(session);
        const start = minutesOf(session.start);
        const end = minutesOf(session.end);
        const listed = isListed(session);
        const all = session.rooms === 'all';
        const wide = !all && session.rooms.length > 1;
        return (
          <article
            class:list={[
              's',
              `s--${session.type}`,
              {
                's--all': all,
                's--wide': wide,
                's--short': end - start <= 30,
                's--long': end - start >= 150 && !all,
              },
            ]}
            data-session
            data-id={session.id}
            data-type={session.type}
            data-listed={String(listed)}
            data-start={start}
            data-end={end}
            data-rooms={sessionRoomLabel(session)}
            data-c0={c0}
            data-c1={c1}
            data-r0={gridRow(start)}
            data-r1={gridRow(end)}
            style={`--r0: ${gridRow(start)}; --r1: ${gridRow(end)}; --c0: ${c0}; --c1: ${c1}`}
            aria-labelledby={`s-${session.id}`}
            aria-description={`${hhmm(session.start)}–${hhmm(session.end)}，${sessionRoomLabel(session)}`}
          >
            {listed && !all && (
              <div class="s__head">
                <p class="s__type">{typeLabels[session.type]}</p>
                <p class="s__status" data-status hidden />
                {canBookmark(session) && <PunchToggle id={session.id} title={session.title} />}
              </div>
            )}
            <h3 class="s__title" id={`s-${session.id}`}>
              {listed ? (
                <a href={`/agenda/${session.id}/`}>
                  <Words text={session.title} />
                  <span class="s__info" aria-hidden="true">
                    i
                  </span>
                </a>
              ) : (
                <Words text={session.title} />
              )}
            </h3>
            <p class="s__meta">
              <time datetime={session.start}>{hhmm(session.start)}</time>
              <span aria-hidden="true">–</span>
              <span class="visually-hidden">到</span>
              <time datetime={session.end}>{hhmm(session.end)}</time>
            </p>
            {all && <p class="s__status" data-status hidden />}
          </article>
        );
      })}
    </div>
  </div>
</div>

<style>
  .timetable-board {
    --head: 3.75rem;
    --slot: 2.75rem;
    --slot-band: 1.5rem;
    --rail-width: 5.5rem;
    --rail-gap: 0.75rem;
    position: relative;
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    gap: var(--rail-gap);
    min-width: 0;
    scroll-margin-top: calc(var(--agenda-controls-height, 0px) + 1rem);
  }
  .tt-rail,
  .tt {
    display: grid;
    grid-template-rows: var(--head) var(--row-template);
  }
  .tt-rail {
    grid-template-columns: 2rem minmax(0, 1fr);
    border-block: 2px solid transparent;
  }
  .tt-rail__head {
    grid-column: 1 / -1;
    grid-row: 1;
    display: grid;
    place-items: center;
    background: var(--color-ink);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    border-bottom: 1px solid var(--color-on-ink-soft);
  }
  .tt__mark {
    grid-column: 2;
    grid-row: var(--r0) / span 2;
    display: grid;
    place-items: center;
    margin-block: 1px;
    border-radius: var(--radius-chip);
    background: var(--color-ink);
    color: var(--color-white);
    font-family: var(--font-sign);
    font-weight: var(--weight-sign);
    font-size: var(--text-sm);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .tt__mark[data-hot] {
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 2px var(--color-ink);
  }
  .tt__phase {
    grid-column: 1;
    grid-row: var(--r0) / var(--r1);
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding-block: 0.75rem;
    writing-mode: vertical-rl;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    background: var(--color-ink);
    color: var(--color-white);
    border-top: 1px solid var(--color-on-ink-rule);
    scroll-margin-top: calc(var(--agenda-controls-height, 0px) + 1rem);
  }
  .tt__phase[data-empty] {
    background: var(--color-paper-deep);
    color: var(--color-ink-soft);
  }
  .tt-scroll {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    container-type: inline-size;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--color-ink) var(--color-paper);
    border: 2px solid var(--color-ink);
    -webkit-overflow-scrolling: touch;
  }
  .tt-scroll:focus-visible {
    outline-offset: 3px;
  }
  .tt {
    position: relative;
    grid-template-columns: repeat(var(--room-count), minmax(0, 1fr));
    width: 100%;
    min-width: 0;
    background: var(--color-white);
  }
  .tt__room {
    grid-row: 1;
    grid-column: var(--c0);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: var(--color-ink);
    color: var(--color-white);
    border-left: 1px solid var(--color-on-ink-rule);
    border-bottom: 1px solid var(--color-on-ink-soft);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.4;
    text-align: center;
    scroll-snap-align: start;
  }
  .tt__room[data-hot] {
    background: var(--color-white);
    color: var(--color-ink);
  }
  .tt__rule {
    grid-column: 1 / -1;
    grid-row: var(--r0);
    border-top: 1px solid var(--color-rule-fine);
    pointer-events: none;
  }
  .s {
    position: relative;
    z-index: 1;
    grid-column: var(--c0) / var(--c1);
    grid-row: var(--r0) / var(--r1);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.35rem;
    min-width: 0;
    min-height: 0;
    margin: 0 0 1px 1px;
    padding: 0.5rem;
    border: 1px solid var(--color-ink);
    background: var(--color-white);
    color: var(--color-ink);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .s__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    min-width: 0;
    min-height: 1.5rem;
  }
  .s__type,
  .s__status {
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
  .s__head:has(.s__status:not([hidden])) .s__type {
    display: none;
  }
  .s :global(.punch) {
    --punch-size: 1.5rem;
    position: relative;
    z-index: 2;
    flex: none;
  }
  .s__title {
    align-self: center;
    font-size: var(--text-sm);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .s__title a {
    text-decoration: none;
  }
  .s__title a:hover {
    text-decoration: none;
  }
  .s__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .s__title a:focus-visible {
    outline: none;
  }
  .s:has(.s__title a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }
  .s__info {
    display: inline-grid;
    place-items: center;
    width: 0.9rem;
    height: 0.9rem;
    margin-left: 0.4rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-family: serif;
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
  }
  .s__meta {
    display: flex;
    flex-wrap: wrap;
    align-self: end;
    justify-content: center;
    gap: 0.15rem;
    color: var(--color-ink-soft);
    font-family: var(--font-sign);
    font-size: var(--text-xs);
    font-weight: var(--weight-sign);
    line-height: 1.4;
  }
  .s--short {
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.25rem;
  }
  .s--short .s__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .s--short .s__meta {
    display: none;
  }
  .s--all {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: 1fr;
    padding: 0;
    gap: 0;
    overflow: visible;
    background: var(--color-ink);
    color: var(--color-white);
    box-shadow: inset 0 1px 0 var(--color-on-ink-soft);
    --color-focus: var(--color-white);
  }
  .s--all .s__title {
    position: sticky;
    left: 0;
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100cqw;
    max-width: 100%;
    height: 100%;
    padding-inline: 1rem;
    font-size: var(--text-lg);
    letter-spacing: 0.12em;
    text-align: center;
  }
  .s--all .s__meta {
    display: none;
  }
  .s--all .s__status {
    position: sticky;
    left: 0.5rem;
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    align-self: center;
    width: fit-content;
    margin-left: 0.5rem;
    color: var(--color-on-ink-soft);
  }
  .s--break:not(.s--all) {
    grid-template-rows: 3.5rem minmax(0, 1fr) 3.5rem;
    gap: 0.5rem;
    padding-block: 0.75rem;
    background-color: var(--color-paper);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 0.4rem,
      var(--color-rule-fine) 0.4rem calc(0.4rem + 1px)
    );
  }
  .s--break:not(.s--all) .s__title {
    grid-row: 2;
    justify-self: center;
    align-self: center;
    padding: 0;
    background: transparent;
    text-align: center;
  }
  .s--break:not(.s--all) .s__title :global(.words) {
    padding: 0.15em 0.5em;
    background: var(--color-paper);
  }
  .s--break:not(.s--all) .s__meta {
    grid-row: 3;
    background: var(--color-paper);
    padding: 0.1em 0.3em;
    justify-self: center;
  }
  .s--wide .s__head,
  .s--wide .s__title {
    position: sticky;
    left: 0.5rem;
    width: calc(100cqw - 1rem);
    max-width: 100%;
  }
  .s--wide:not(.s--break) .s__meta {
    position: sticky;
    left: 0.5rem;
    width: calc(100cqw - 1rem);
    max-width: 100%;
  }
  .s[data-dim] {
    background: #f3f3f3;
    background-image: none;
    color: #929292;
    border-color: #d0d0d0;
  }
  .s[data-dim] :is(.s__type, .s__meta, .s__status) {
    color: #929292;
  }
  .s[data-dim] :global(.punch) {
    opacity: 0.4;
  }
  .s--all[data-dim] {
    background: #e3e3e3;
    color: #777;
  }
  .s[data-hot],
  .s[data-state='now'] {
    background: var(--color-ink);
    background-image: none;
    color: var(--color-white);
    --color-focus: var(--color-white);
    --chad-bg: var(--color-ink);
  }
  .s[data-hot] :is(.s__type, .s__meta, .s__status),
  .s[data-state='now'] :is(.s__type, .s__meta, .s__status) {
    color: var(--color-on-ink-soft);
  }
  .s--break[data-hot] .s__title :global(.words),
  .s--break[data-state='now'] .s__title :global(.words) {
    background: var(--color-ink);
  }
  .s[data-hot] .s__title,
  .s[data-hot] .s__meta,
  .s[data-state='now'] .s__title,
  .s[data-state='now'] .s__meta {
    background-color: var(--color-ink);
  }
  .s--all[data-hot] {
    background: var(--color-white);
    color: var(--color-ink);
    --color-focus: var(--color-ink);
  }
  .s--all[data-hot] .s__title {
    background: var(--color-white);
  }
  .s[data-state='past'] {
    color: var(--color-ink-muted);
  }
  @media (min-width: 72rem) {
    .s--long:not(.s--break) {
      grid-template-rows: 4.5rem minmax(0, 1fr) 4.5rem;
    }
    .s--long:not(.s--break) .s__title {
      justify-self: center;
      min-height: 0;
      max-height: 100%;
      max-width: 100%;
      writing-mode: vertical-rl;
      text-orientation: upright;
      font-size: var(--text-md);
      letter-spacing: 0.2em;
      line-height: 1.2;
    }
    .s--long .s__title :global(.words) {
      word-break: normal;
    }
    .s--long .s__info {
      display: none;
    }
  }
  @media (max-width: 71.99rem) {
    .timetable-board {
      --rail-width: 3rem;
      --rail-gap: 0.5rem;
    }
    .tt-rail {
      grid-template-columns: minmax(0, 1fr);
    }
    .tt__mark {
      grid-column: 1;
    }
    .tt__phase {
      grid-column: 1;
      grid-row: var(--r0);
      align-self: start;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      border: 0;
    }
    .tt {
      --column-width: 12rem;
      width: calc(var(--room-count) * var(--column-width));
    }
    .tt__room {
      font-size: 1rem;
    }
    .s {
      padding: 0.5rem 0.65rem;
    }
    .s__title {
      font-size: 0.9375rem;
    }
    .s--all {
      padding: 0;
    }
    .s--all .s__title {
      font-size: 1rem;
    }
    .s--long {
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
    .s--long:not(.s--all):not(.s--break) .s__title {
      align-self: start;
      padding-block: 1rem;
    }
  }
  @media (max-width: 47.99rem) {
    .tt {
      --column-width: calc(100cqw - 1.5rem);
    }
    .s__title {
      font-size: 1rem;
    }
    .s--short .s__title {
      font-size: 0.9375rem;
    }
  }
</style>
