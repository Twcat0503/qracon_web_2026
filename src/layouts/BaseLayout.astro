---
import '../styles/global.css';
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import {
  buildSiteStructuredData,
  type StructuredData,
} from '../utils/seo';
import { sitePath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  canonical?: boolean;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  structuredData?: StructuredData[];
}

const {
  title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  canonical: includeCanonical = true,
  image = '/og-image.png',
  imageAlt = `${site.name} ${site.nameZh}活動視覺，${site.dateLabel} 在${site.venue.org}${site.venue.name}`,
  noindex = false,
  structuredData = [],
} = Astro.props;

const fullTitle = title
  ? `${title}｜${site.name}`
  : `${site.name} ${site.nameZh}｜${site.dateLabel} ${site.venue.org}${site.venue.name}`;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(sitePath(canonicalPath), siteUrl);
canonicalUrl.search = '';
canonicalUrl.hash = '';
if (!canonicalUrl.pathname.endsWith('/')) canonicalUrl.pathname += '/';

const canonical = includeCanonical ? canonicalUrl.href : undefined;
const ogImage = new URL(sitePath(image), siteUrl).href;
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large';
const structuredGraph = {
  '@context': 'https://schema.org',
  '@graph': [...buildSiteStructuredData(siteUrl), ...structuredData],
};
const structuredJson = JSON.stringify(structuredGraph).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href={sitePath('/sitemap.xml')} type="application/xml" />
    <link rel="icon" href={sitePath('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={sitePath('/favicon-96x96.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={sitePath('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#d9d9d9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <Font cssVariable="--font-barlow-condensed" preload />
    <Font cssVariable="--font-noto-sans-tc" />
    <slot name="head" />
    <script is:inline type="application/ld+json" set:html={structuredJson} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-skip);
    padding: var(--space-2) var(--space-4);
    background: var(--color-ink);
    color: var(--color-white);
    font-weight: var(--weight-bold);
    text-decoration: none;
    translate: 0 -200%;
  }

  .skip-link:focus-visible {
    translate: 0 0;
    outline-color: var(--color-white);
  }

  main:focus {
    outline: none;
  }
</style>

